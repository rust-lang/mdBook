// This GUI test checks the bypass-repetitive-content accessibility feature. (WCAG 2.4.1)
set-timeout: 1000
go-to: |DOC_PATH| + "basic/index.html"

// The skip link should be hidden initially (positioned off-screen above viewport)
store-position: (".bypass-block", {"y": y_before})
store-size: (".bypass-block", {"height": height_before})
assert: |y_before| + |height_before| < 0

// The skip link should be the first focusable element when pressing Tab
press-key: "Tab"
wait-for: ".bypass-block:focus"

// When focused, the link should be visible (top: 0px)
assert-css: (".bypass-block:focus", {"top": "0px"})

// Pressing Enter on the skip link should move focus to main content
press-key: "Enter"
wait-for: "#mdbook-content:focus"
