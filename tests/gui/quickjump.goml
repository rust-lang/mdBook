// This tests the quick jump (Cmd/Ctrl+K) that jumps to chapters by title or
// file name.

fail-on-js-error: true
go-to: |DOC_PATH| + "search/chapter_1.html"

// The quick jump box is hidden by default.
assert-css: ("#mdbook-quickjump", {"display": "none"})

define-function: (
    "open-jump",
    [],
    block {
        key-down-then-up: ("Control", block {
            press-key: "k"
        })
        wait-for-css: ("#mdbook-quickjump", {"display": "block"})
        assert: "#mdbook-quickjump-input:focus"
    }
)

call-function: ("open-jump", {})

// With an empty query nothing is listed.
assert-count: ("#mdbook-quickjump-results li", 0)
assert-css: ("#mdbook-quickjump-results-outer", {"display": "none"})

// Type a title prefix to filter the chapters.
write: "Chapter"
wait-for-css: ("#mdbook-quickjump-results-outer", {"display": "block"})
assert-count: ("#mdbook-quickjump-results li", 2)
wait-for-text: ("#mdbook-quickjump-results li.focus .quickjump-title", "1. Chapter 1")

// Move the selection down and open the result with Enter.
press-key: "ArrowDown"
wait-for-text: ("#mdbook-quickjump-results li.focus .quickjump-title", "2. Chapter 2")
press-key: "Enter"
wait-for-text: ("title", "Chapter 2 - search")

// Reopen and search by file name instead of title.
call-function: ("open-jump", {})
write: "chapter_1"
assert-count: ("#mdbook-quickjump-results li", 1)
wait-for-text: ("#mdbook-quickjump-results li.focus .quickjump-title", "1. Chapter 1")

// Clicking a result should also navigate.
click: "#mdbook-quickjump-results li.focus"
wait-for-text: ("title", "Chapter 1 - search")

// Escape closes the box again.
call-function: ("open-jump", {})
write: "Chapter 2"
press-key: "Escape"
wait-for-css: ("#mdbook-quickjump", {"display": "none"})
assert-text: ("title", "Chapter 1 - search")
