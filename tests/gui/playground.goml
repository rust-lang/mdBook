// Regression test for https://github.com/rust-lang/mdBook/issues/3215

go-to: |DOC_PATH| + "playground/chapter_1.html"

// Check play/reset buttons
assert-count: ("pre.playground > .buttons > .play-button", 2)
assert-count: ("pre.playground > .buttons > .reset-button", 1)

// Check unexpected play/reset buttons
assert-count: ("code .buttons", 0)
